# These settings do not unlock private access until authentication is implemented during class.
SITE_PASSWORD=
SESSION_SECRET=
# AI provider, read only on the server. Never use NEXT_PUBLIC_ variables.
# AI_PROVIDER: openai, anthropic, gemini, or openai-compatible (OpenRouter, Groq, local servers).
# AI_MODEL examples: gpt-5 (openai), claude-opus-5-5 (anthropic), gemini-flash-latest (gemini).
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Only for openai-compatible, for example https://openrouter.ai/api/v1
AI_BASE_URL=
# Optional, openai and anthropic only: low, medium or high. Lower is faster.
AI_REASONING_EFFORT=
