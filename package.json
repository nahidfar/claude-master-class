    "preflight": "npm test && npm run lint && npm run build && npm run typecheck && npm run test:http"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@google/genai": "^2.31.0",
    "next": "16.4.2",
    "openai": "^7.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
